{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one.org/search/promptlab/rung.schema.json",
  "title": "Prompt ladder stage manifest",
  "description": "One stage (extract or bind) of a prompt ladder rung: its ordered block list, and, on the bind stage's own file only, the run configuration shared by both stages.",
  "type": "object",
  "required": ["name", "description", "stage", "blocks"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["extract", "bind"] },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/block" }
    },
    "run": { "$ref": "#/$defs/run" }
  },
  "if": {
    "properties": { "stage": { "const": "bind" } }
  },
  "then": {
    "required": ["name", "description", "stage", "blocks", "run"]
  },
  "else": {
    "not": { "required": ["run"] }
  },
  "$defs": {
    "block": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sep": { "enum": ["blank", "line"] },
        "unit": { "type": "string", "minLength": 1 },
        "core": { "type": "boolean" }
      }
    },
    "run": {
      "type": "object",
      "required": ["capture", "top_k", "seeds", "model", "thinking"],
      "additionalProperties": false,
      "properties": {
        "capture": { "type": "string", "minLength": 1 },
        "top_k": { "type": "integer", "minimum": 1 },
        "seeds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer" }
        },
        "model": { "type": "string", "minLength": 1 },
        "thinking": {
          "type": "object",
          "additionalProperties": { "type": ["string", "null"] }
        }
      }
    }
  }
}
