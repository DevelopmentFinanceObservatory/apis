# Environment for the local dfo-apis stack (scripts/local-stack/README.md). stack.sh passes
# this file to every `uv run` with --env-file: the migrators, the release publisher, the seed
# and the server. Every value is a fixed local placeholder; none is a real secret.

# Surfaces: local_app.py mounts Datasets and Presentation and leaves Search out; the flags
# below say the same for any code that reads them.
DFO_DATASETS_SURFACE=1
DFO_PRESENTATION_SURFACE=1

# Postgres 18 from compose.yaml, one server holding both databases.
DATASET_STORE_HOST=127.0.0.1
DATASET_STORE_PORT=55418
DATASET_STORE_DATABASE=datasets
DATASET_STORE_MIGRATOR_DB_USER=dfo_local_migrator
DATASET_STORE_MIGRATOR_DB_PASSWORD=local-migrator
DATASET_STORE_RUNTIME_DB_USER=datasets_runtime
DATASET_STORE_RUNTIME_DB_PASSWORD=local-runtime
DATASET_STORE_WORKER_DB_USER=datasets_worker
PRESENTATION_STORE_HOST=127.0.0.1
PRESENTATION_STORE_PORT=55418
PRESENTATION_STORE_DATABASE=presentation
PRESENTATION_STORE_MIGRATOR_DB_USER=dfo_local_migrator
PRESENTATION_STORE_MIGRATOR_DB_PASSWORD=local-migrator
PRESENTATION_STORE_RUNTIME_DB_USER=presentation_runtime
PRESENTATION_STORE_RUNTIME_DB_PASSWORD=local-runtime

# fake-gcs-server from compose.yaml. google-cloud-storage reads STORAGE_EMULATOR_HOST and
# sends anonymous requests to it; stack.sh creates both buckets.
STORAGE_EMULATOR_HOST=http://127.0.0.1:54443
# Lets artifact_store.signing hand out the emulator's unsigned links; it refuses to start with
# STORAGE_EMULATOR_HOST set and this unset.
DFO_LOCAL_STACK=1
# Download links go out on the API's own origin, which local_app.py serves them from.
STORAGE_EMULATOR_LINK_BASE=http://127.0.0.1:58083
GOOGLE_CLOUD_PROJECT=dfo-local
DATASETS_ARTIFACT_BUCKET_WORKING=dfo-local-working
DATASETS_ARTIFACT_BUCKET_PINNED=dfo-local-pinned

# GRAPH_RELEASE_URI and ORIGIN_CATALOGUE_URI are absolute file:// URIs under runs/local-stack/,
# so stack.sh exports them rather than this file naming them.

# Upstreams the mint, definition and refresh doors would read. Port 9 (discard) refuses every
# connection, so a route that reaches upstream fails fast instead of calling a real graph.
# The graph base is local_app.py's own `/v2/node` double over the fixture, which the
# Presentation surface's graph client reads for labels and citations.
DATASETS_GRAPH_BASE_URL=http://127.0.0.1:58083/local-stack/graph/core/api
DATASETS_SDMX_BASE_URL=http://127.0.0.1:9/core/api
UN_GRAPH_BASE_URL=http://127.0.0.1:9/core/api
SEARCH_GRAPH_BASE=http://127.0.0.1:9

DFO_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Principals (header x-dfo-principal) and caller settings.
DATASETS_FIRST_PARTY_PRINCIPAL=local-publish-principal
DATASETS_PIN_FIRST_PARTY_PRINCIPAL=local-pin-principal
LIVE_REFRESH_PRINCIPAL=local-refresh-principal
PRESENTATION_SHARE_IMPORT_PRINCIPAL=local-share-import-principal
DFO_CALLER_PRINCIPAL=local-caller-principal
DFO_CALLER_HMAC_KEY=local-caller-hmac-key
