{
  "version": 1,
  "disable_existing_loggers": false,
  "handlers": {
    "stdout": {
      "()": "dfo_platform.cloud_logging.stdout_handler"
    }
  },
  "root": {
    "level": "WARNING",
    "handlers": ["stdout"]
  },
  "loggers": {
    "datasets_api": {
      "level": "INFO"
    },
    "search": {
      "level": "INFO"
    },
    "uvicorn": {
      "level": "INFO"
    }
  }
}
